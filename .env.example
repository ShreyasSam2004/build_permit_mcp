# Optional but recommended: Socrata throttles anonymous requests more aggressively.
# Create a free app token on any Socrata portal: sign in, then Profile > Developer Settings.
# This server reads environment variables only (no .env loading); pass them via your MCP client config.
SOCRATA_APP_TOKEN=

# Optional
# PERMITS_LOG_LEVEL=INFO
# PERMITS_CACHE_TTL=600
