# Optional but recommended: Socrata throttles anonymous requests more aggressively.
# Create a free app token on any Socrata portal: sign in, then Profile > Developer Settings.
# This server reads environment variables only (no .env loading); pass them via your MCP client config.
SOCRATA_APP_TOKEN=

# Optional
# PERMITS_LOG_LEVEL=INFO
# PERMITS_CACHE_TTL=600

# HTTP transport only (permits-mcp --transport http)
# PERMITS_API_KEY=           # when set, /mcp requires "Authorization: Bearer <key>"; /healthz stays open
# PERMITS_ALLOWED_HOSTS=     # comma-separated public hostnames; enables DNS-rebinding protection
# HOST=127.0.0.1
# PORT=8000

# Eval only (eval/harness.py); never needed by the server
# ANTHROPIC_API_KEY=

